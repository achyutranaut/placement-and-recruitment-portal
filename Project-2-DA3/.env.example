# ==============================================================================
# Student Placement & Recruitment Portal — Local Environment Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# NOTE: .env is ignored by Git. Never commit real secrets.
# ==============================================================================

# --- JWT Authentication ---
# 256-bit secret key for signing tokens. If left blank, run_portal.sh will
# automatically generate an ephemeral 256-bit cryptographically secure key
# for the launcher session.
JWT_SECRET=

# --- Oracle Database 23ai Free (Primary OLTP Source of Truth) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=placement_app
ORACLE_PASSWORD=OraclePassword123!

# --- Neo4j Graph Database (Optional Secondary Graph Projection) ---
# When false, the portal operates in Oracle-only mode and graph features degrade gracefully.
PORTAL_NEO4J_ENABLED=true
# Local Docker Neo4j:
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=placement2026
# Cloud Aura (Alternative):
# NEO4J_URI=neo4j+s://<YOUR_INSTANCE_ID>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# --- Qdrant Vector Database (Vector Search Engine for Semantic Recruitment) ---
PORTAL_QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=placement-semantic-search

# --- Redis Cache (Loopback Bound & Password Protected) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Service Ports ---
SERVER_PORT=8080
FRONTEND_PORT=3001
