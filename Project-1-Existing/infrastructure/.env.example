# Database Configuration (Oracle Database 23ai Free / XE)
ORACLE_USER=c##placement_app
ORACLE_PASSWORD=OraclePassword123!
ORACLE_DATABASE=FREEPDB1
ORACLE_PORT=1521

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=oracle
SERVER_PORT=8080

# Security & JWT - In production, generate via: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_256_bit_secret
JWT_EXPIRATION_MS=86400000

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend Port
FRONTEND_PORT=3000
