# ==============================================================================
# Project 1 (Existing) — Local Environment Configuration Template
# Student Placement & Recruitment Portal (Oracle 23ai + Spring Boot + React)
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# NOTE: .env is ignored by Git. Never commit real secrets.
# ==============================================================================

# --- JWT Authentication ---
# 256-bit secret key for signing tokens. If left blank, run_portal.sh will
# automatically generate an ephemeral 256-bit secure key for the session.
JWT_SECRET=replace_with_secure_random_256_bit_secret
JWT_EXPIRATION_MS=86400000

# --- Oracle Database 23ai Free (Primary Authoritative OLTP) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=c##placement_app
ORACLE_PASSWORD=OraclePassword123!

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Service Ports ---
SERVER_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=oracle
